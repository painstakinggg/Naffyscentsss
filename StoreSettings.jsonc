{
  "name": "StoreSettings",
  "type": "object",
  "properties": {
    "whatsapp_number": {
      "type": "string",
      "title": "WhatsApp Number",
      "default": "2348012345678"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email",
      "default": ""
    },
    "instagram_handle": {
      "type": "string",
      "title": "Instagram Handle",
      "default": "naffyscents"
    },
    "snapchat_handle": {
      "type": "string",
      "title": "Snapchat Handle",
      "default": "naffyscents"
    },
    "tiktok_handle": {
      "type": "string",
      "title": "TikTok Handle",
      "default": "naffyscents"
    },
    "facebook_handle": {
      "type": "string",
      "title": "Facebook Handle",
      "default": ""
    },
    "store_address": {
      "type": "string",
      "title": "Store Address",
      "default": "Ilaro, Ogun State, Nigeria"
    },
    "maps_url": {
      "type": "string",
      "title": "Google Maps URL",
      "default": ""
    },
    "business_hours": {
      "type": "string",
      "title": "Business Hours (physical store)",
      "default": ""
    },
    "pickup_hours": {
      "type": "string",
      "title": "Pickup Hours (online orders)",
      "default": "12:00 PM \u2013 5:00 PM"
    },
    "logistics_provider": {
      "type": "string",
      "title": "Logistics Provider",
      "default": "Josh Logistics"
    },
    "delivery_fee_ilaro_min": {
      "type": "number",
      "title": "Ilaro Delivery Fee Min",
      "default": 1000
    },
    "delivery_fee_ilaro_max": {
      "type": "number",
      "title": "Ilaro Delivery Fee Max",
      "default": 2000
    },
    "delivery_info_note": {
      "type": "string",
      "title": "Delivery Info Note",
      "default": "Delivery within Ilaro: \u20a61,000 \u2013 \u20a62,000 via Josh Logistics"
    },
    "delivery_fee_lagos": {
      "type": "number",
      "title": "Lagos Delivery Fee (legacy)",
      "default": 2500
    },
    "delivery_fee_nationwide": {
      "type": "number",
      "title": "Nationwide Delivery Fee (legacy)",
      "default": 4500
    },
    "bank_name": {
      "type": "string",
      "title": "Bank Name",
      "default": ""
    },
    "account_name": {
      "type": "string",
      "title": "Account Name",
      "default": ""
    },
    "account_number": {
      "type": "string",
      "title": "Account Number",
      "default": ""
    },
    "payment_instructions": {
      "type": "string",
      "title": "Payment Instructions",
      "default": ""
    },
    "hero_headline": {
      "type": "string",
      "title": "Hero Headline",
      "default": "SCENT THAT SPEAKS BEFORE YOU DO."
    },
    "hero_subtext": {
      "type": "string",
      "title": "Hero Subtext",
      "default": "Discover fragrances crafted to leave a lasting impression."
    },
    "promo_text": {
      "type": "string",
      "title": "Promo Text",
      "default": "YOUR SIGNATURE SCENT AWAITS."
    },
    "newsletter_text": {
      "type": "string",
      "title": "Newsletter Text",
      "default": "Sign up for new fragrance drops, exclusive offers and curated scent stories."
    },
    "brand_story_heading": {
      "type": "string",
      "title": "Brand Story Heading",
      "default": "MORE THAN A FRAGRANCE. IT'S AN IDENTITY."
    }
  },
  "required": [
    "whatsapp_number"
  ]
}