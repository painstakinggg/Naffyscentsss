{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Product ID"
    },
    "product_name": {
      "type": "string",
      "title": "Product Name"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "rating": {
      "type": "number",
      "title": "Rating",
      "default": 5
    },
    "review": {
      "type": "string",
      "title": "Review"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "order_number": {
      "type": "string",
      "title": "Order Number"
    },
    "verified": {
      "type": "boolean",
      "title": "Verified Purchase",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "title": "Featured Testimonial",
      "default": false
    },
    "approved": {
      "type": "boolean",
      "title": "Approved",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "title": "Status",
      "default": "Pending"
    }
  },
  "required": [
    "customer_name",
    "rating",
    "review"
  ]
}